# Database: Supabase Postgres (Dashboard -> Connect -> Session pooler). Dummy example, replace the
# <placeholders>. Drizzle and the migrations use this direct Postgres connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<your-database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase web API values. NOT used by the app right now (we talk to Postgres through DATABASE_URL).
# Keep the secret key private: it bypasses all access rules. Never prefix it with NEXT_PUBLIC_.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Clerk (from the Clerk dashboard / `clerk init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up


TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TEXTBELT_API_KEY=
# twilio | textbelt
SMS_PROVIDER=twilio
# Only this US number may call POST /api/sms. Example: +15555550100
SMS_ALLOWED_FROM=
